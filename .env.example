# despachante-digital/.env.example
# Copie para .env e preencha. NUNCA versione o .env.

# Pastas de trabalho
PASTA_ENTRADA=dados/entrada
PASTA_PROCESSADOS=dados/processados
PASTA_ERROS=dados/erros
PASTA_SAIDA=dados/saida
PASTA_LOGS=logs

# Tolerâncias para divergência (Etapa 3)
TOLERANCIA_VALOR_USD=0.01
TOLERANCIA_PESO_KG=0.5

# E-mail (Etapa 5) — use senha de app, nunca a senha da conta
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
EMAIL_DESTINATARIOS=

# Agendamento (Etapa 6) — expressão cron
CRON_RELATORIO=0 18 * * 1-5
